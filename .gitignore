# Large or generated artefacts
data/*
!data/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
*.pt
*.safetensors
*.gguf
logs/

# uv environments: only the lock files are tracked
envs/*/*
!envs/*/requirements.lock

# Model and tool caches
.cache/
hf_cache/
huggingface/
torch_cache/
.ruff_cache/
.pytest_cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/

# Jupyter
.ipynb_checkpoints

# Secrets and local settings
.env
.env.*
